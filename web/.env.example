# このファイルを .env という名前でコピーして、値を入れてください（.env は公開しないこと）

# Supabase の「Project Settings → API Keys」にある値
PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# 定期実行の合言葉（長いランダムな文字列）。Vercel にも同じ値を設定する
CRON_SECRET=change-me-to-a-long-random-string

# メール通知を使う場合だけ（Resend：https://resend.com）
RESEND_API_KEY=
MAIL_FROM=資材ノート <onboarding@resend.dev>

# 公開したアプリのURL（メールに載せる）
APP_URL=https://your-app.vercel.app
